# Optional: copy to .env and change values as needed.
APP_BIND=127.0.0.1
APP_PORT=8765
# Set to 1 only when accessing the app through HTTPS.
RESEARCH_SECURE_COOKIE=0

TOOL_WORKSPACE=./tool-workspace
# On Linux, set these to the output of id -u and id -g for writable bind mounts.
TOOL_UID=1000
TOOL_GID=1000

# Image digests are pinned in compose.yaml. Override image references here if needed.
# MATHLIB_REVISION must be a full commit SHA; Lean is selected from its lean-toolchain.
# MATHLIB_REVISION=56a005855ea17e0b0958f73ec801ae140b0a1679

# Optional agents profile; never put login credentials in this file or build args.
# TRACKER_CODEX_VERSION=0.167.0
